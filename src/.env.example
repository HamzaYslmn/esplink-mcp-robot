# Defaults for the robot. main.py loads .env then falls back to this file.
# The mode is a command, not a setting: `esplink-buddy [mcp|chat|demo|gif NAME] [-e]`.

# --- Assistant (local Ollama, only used by `chat`) ----------------------------
# Install Ollama and pull the model:  ollama pull qwen3.5:4b
ROBOT_MODEL=qwen3.5:4b
OLLAMA_HOST=http://localhost:11434

# Speed knobs (tuned for 8GB VRAM). THINK level sets the model's chain-of-thought:
# low = brief reasoning (fast); medium/high deeper; false turns it off.
ROBOT_THINK=low
ROBOT_NUM_CTX=4096        # context window; smaller = less VRAM, faster prompt

# --- ESP32 (Bluetooth) --------------------------------------------------------
# Target: empty = auto-pick the first board; or a board name or MAC address.
# Password: must match the firmware's EspLink.ble.begin("..."); the default
# firmware (EspLink.ble.begin()) uses "esplink".
ROBOT_BLE_TARGET=
ROBOT_PASSWORD=esplink

# --- OLED (128x64 SSD1306 / SH1106) -------------------------------------------
ROBOT_OLED_SDA=21
ROBOT_OLED_SCL=22
ROBOT_BRIGHTNESS=255      # panel brightness cap, 0..255 (moods like 'standby' dim below it)

# --- Animation ----------------------------------------------------------------
ROBOT_FPS=24
