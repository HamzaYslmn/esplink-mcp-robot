# Defaults for the robot. main.py loads .env then falls back to this file.
# The mode is a command, not a setting: `esplink-buddy [mcp|chat|demo|gif NAME] [-e]`.

# --- Assistant (local Ollama, only used by `chat`) ----------------------------
# Install Ollama and pull the model:  ollama pull qwen3.5:4b
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_HOST=http://localhost:11434
OLLAMA_THINK=true         # true / false, or a level the model lists in `ollama show` (gpt-oss: low/medium/high)

# --- ESP32 (Bluetooth) --------------------------------------------------------
ROBOT_BLE_TARGET=         # board name or MAC; empty = first board found (`uv run esplink -b set-name pip` names it)
# ROBOT_PASSWORD=         # only if the firmware's EspLink.ble.begin("...") isn't the default "esplink"

# --- OLED (128x64 SSD1306 / SH1106) -------------------------------------------
ROBOT_OLED_SDA=1         # classic ESP32: GPIO1 is the USB serial TX, so wire 21/22 and set them here
ROBOT_OLED_SCL=2
ROBOT_BRIGHTNESS=255      # panel brightness cap, 0..255 (moods like 'standby' dim below it)

# --- Animation ----------------------------------------------------------------
ROBOT_FPS=24
